{%- doc -%}
  Icona a linee per una card settore dell'Atelier del Ricamo.
  @param {string} [icon] - chiave icona: hotel, restaurant, business, nautical, health, school, events, association, needle (default)
{%- enddoc -%}
{%- liquid
  assign ic = icon | default: 'needle'
-%}
{%- capture o -%}<svg class="ricamo-sector-icon__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{%- endcapture -%}
{%- case ic -%}
  {%- when 'hotel' -%}
    {{ o }}<path d="M3 18v-5a2 2 0 0 1 2-2h9a3 3 0 0 1 3 3v4"/><path d="M3 18h18"/><path d="M3 18v2"/><path d="M21 18v2"/><path d="M3 13V8"/><circle cx="7.5" cy="9.5" r="1.4"/></svg>
  {%- when 'restaurant' -%}
    {{ o }}<path d="M8 22V12"/><path d="M8 12c-1.8 0-2.8-1-2.8-3V3"/><path d="M8 12c1.8 0 2.8-1 2.8-3V3"/><path d="M8 12V4"/><path d="M16.5 3c-1.6 1.6-2.2 4.4-1.7 7 .3 1.4 1 1.9 1.7 2v10"/></svg>
  {%- when 'business' -%}
    {{ o }}<rect x="2.5" y="7" width="19" height="13" rx="2"/><path d="M16 20V6a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v14"/></svg>
  {%- when 'nautical' -%}
    {{ o }}<circle cx="12" cy="5" r="2.5"/><line x1="12" y1="7.5" x2="12" y2="21"/><path d="M5 12H2a10 10 0 0 0 20 0h-3"/><line x1="8.5" y1="10.5" x2="15.5" y2="10.5"/></svg>
  {%- when 'health' -%}
    {{ o }}<rect x="3" y="3" width="18" height="18" rx="3"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
  {%- when 'school' -%}
    {{ o }}<path d="M12 4 2 9l10 5 10-5-10-5z"/><path d="M6 11.5V16c0 1.4 2.7 2.8 6 2.8s6-1.4 6-2.8v-4.5"/><line x1="22" y1="9" x2="22" y2="13.5"/></svg>
  {%- when 'events' -%}
    {{ o }}<rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="16" y1="3" x2="16" y2="7"/><path d="M12 18.5c-1.7-1.2-3-2.2-3-3.6 0-1 .8-1.6 1.6-1.6.7 0 1.1.4 1.4.8.3-.4.7-.8 1.4-.8.8 0 1.6.6 1.6 1.6 0 1.4-1.3 2.4-3 3.6z"/></svg>
  {%- when 'association' -%}
    {{ o }}<line x1="5" y1="21" x2="5" y2="3"/><path d="M5 4h12l-3 4 3 4H5"/></svg>
  {%- else -%}
    {{ o }}<path d="M4.5 19.5 14 10"/><circle cx="15.6" cy="8.4" r="1.7"/><path d="M15.9 6.7c1.8-.6 3.4.8 2.9 2.6-.3 1.3-1.9 1.8-2.9 1"/></svg>
{%- endcase -%}
