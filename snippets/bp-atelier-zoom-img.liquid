{%- comment -%}
  Immagine di dettaglio con pulsante di ingrandimento (lightbox).
  Uso: {% render 'bp-atelier-zoom-img', img: 'tessuto-camicia-colletti.webp', alt: tessuti_colletti %}

  Parametri opzionali:
  - src:   URL già risolto, al posto di un file in assets (es. una foto caricata
           dal personalizzatore). Se c'è, vince su img.
  - w / h: dichiarano il rapporto vero quando la foto non è la solita striscia
           2:1 (es. le tavole quadrate dell'anatomia della giacca).
  - class: classe extra sul pulsante, per chi incornicia la foto a modo suo.
{%- endcomment -%}
{%- liquid
  assign zoom_src = img | asset_url
  if src != blank
    assign zoom_src = src
  endif
  assign zoom_w = w | default: 1600
  assign zoom_h = h | default: 800
-%}
<button type="button" class="bp-atelier__extra-zoom{% if class != blank %} {{ class }}{% endif %}" data-at-zoom data-zoom-src="{{ zoom_src }}" data-zoom-alt="{{ alt | escape }}" aria-label="{{ 'brand.sarto_domicilio.tessuti_zoom' | t }}: {{ alt | escape }}">
  <img class="bp-atelier__extra-img" src="{{ zoom_src }}" width="{{ zoom_w }}" height="{{ zoom_h }}" loading="lazy" alt="{{ alt | escape }}">
  <span class="bp-atelier__extra-zoom-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
  </span>
</button>
