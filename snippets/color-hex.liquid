    when 'panna'
      assign swatch_color = '#EDE6D6'
    when 'polvere'
      assign swatch_color = '#C9BEC2'
    when 'rosa'
      assign swatch_color = '#E3A9C0'
    when 'rossa'
      assign swatch_color = '#B23A2E'
    when 'rosso'
      assign swatch_color = '#B23A2E'
    when 'sabbia'
      assign swatch_color = '#D9C9A3'
    when 'tabacco'
      assign swatch_color = '#7A5A34'
    when 'taupe'
