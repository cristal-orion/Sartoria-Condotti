{%- doc -%}
  Maps an Italian color-name string (e.g. "blu notte", "testa di moro") to a
  representative hex value, used by color-swatches.liquid to render solid
  color-dot swatches. Add new entries here whenever a new color name is
  introduced in product titles.

  @param {string} name - The color name (any case)
{%- enddoc -%}
{% liquid
  assign key = name | downcase | strip
  case key
    when 'arancio'
      assign swatch_color = '#E07B39'
    when 'avion'
      assign swatch_color = '#A9906D'
    when 'avion blu'
      assign swatch_color = '#6E7A8A'
    when 'azzurra'
      assign swatch_color = '#6FA8D8'
    when 'azzurro'
      assign swatch_color = '#6FA8D8'
    when 'azzurro chiaro'
      assign swatch_color = '#8FC1E3'
    when 'beige'
      assign swatch_color = '#D8C7A4'
    when 'beige moro'
      assign swatch_color = '#A98F6D'
    when 'beige scuro'
      assign swatch_color = '#8A7355'
    when 'bianca'
      assign swatch_color = '#F7F5F0'
    when 'bianca azzurra'
      assign swatch_color = '#BBD6EA'
    when 'bianca blu'
      assign swatch_color = '#5E7CA8'
    when 'bianco'
      assign swatch_color = '#F7F5F0'
    when 'bianco azzurro'
      assign swatch_color = '#BBD6EA'
    when 'bianco blu'
      assign swatch_color = '#5E7CA8'
    when 'blu'
      assign swatch_color = '#1B3A6B'
    when 'blu amaranto'
      assign swatch_color = '#7B1E3D'
    when 'blu chiaro'
      assign swatch_color = '#3E6FA6'
    when 'blu fango'
      assign swatch_color = '#1B3A6B'
    when 'blu medio'
      assign swatch_color = '#2C4F86'
    when 'blu navy'
      assign swatch_color = '#14213D'
    when 'blu notte'
      assign swatch_color = '#0D1B33'
    when 'blu royal'
      assign swatch_color = '#1440C4'
    when 'blu scuro'
      assign swatch_color = '#0F1F3D'
    when 'blue'
      assign swatch_color = '#1B3A6B'
    when 'bluette'
      assign swatch_color = '#4A7FC4'
    when 'bordeaux'
      assign swatch_color = '#6C1F2C'
    when 'bordeaux blu'
      assign swatch_color = '#6C1F2C'
    when 'celeste'
      assign swatch_color = '#A9D6E5'
    when 'cobalto'
      assign swatch_color = '#1E4FA3'
    when 'cognac'
      assign swatch_color = '#8B4A2B'
    when 'crust legno'
      assign swatch_color = '#7A5230'
    when 'cuoio'
      assign swatch_color = '#A0673A'
    when 'denim'
      assign swatch_color = '#4C6B8A'
    when 'fango'
      assign swatch_color = '#6E6355'
    when 'fantasia coriandoli'
      assign swatch_color = '#C9A84C'
    when 'fantasia floreale'
      assign swatch_color = '#C9A84C'
    when 'fantasia geometrica'
      assign swatch_color = '#C9A84C'
    when 'grigia'
      assign swatch_color = '#8C8C88'
    when 'grigio'
      assign swatch_color = '#8C8C88'
    when 'grigio antracite'
      assign swatch_color = '#3F3F3F'
    when 'grigio bordeaux'
      assign swatch_color = '#6C1F2C'
    when 'grigio chiaro'
