{%- doc -%}
  Una scheda prodotto per la pagina "I tuoi preferiti".

  Non è una sezione da mettere in una pagina: viene chiesta via Section
  Rendering API da assets/wishlist.js con
  /products/<handle>?section_id=wishlist-card
  Rendendola dal server, prezzi, sconti e foto sono sempre quelli veri: nel
  browser salviamo solo gli handle, nessuna copia dei dati che invecchia.

  Stile allineato alle griglie editoriali Sartoria (.bpc__*): stesso rapporto
  immagine, stesso titolo, stesso prezzo con barrato.
{%- enddoc -%}

{% liquid
  assign p = product
  if p == blank
    assign p = closest.product
  endif
%}

{%- if p != blank -%}
  <div class="wl-card">
    <a class="wl-card__link" href="{{ p.url }}" aria-label="{{ p.title | escape }}"></a>

    {% render 'wishlist-button', product: p, style: 'icon' %}

    <div class="wl-card__media">
      {%- if p.featured_media -%}
        {{
          p.featured_media
          | image_url: width: 900
          | image_tag:
            widths: '300, 450, 600, 900',
            sizes: '(max-width: 749px) 45vw, 22vw',
            alt: p.title,
            loading: 'lazy',
            class: 'wl-card__img'
        }}
      {%- endif -%}
    </div>

    <h3 class="wl-card__name">{{ p.title }}</h3>
    {% render 'color-swatches', product: p %}
    <p class="wl-card__price">
      {%- if p.compare_at_price > p.price -%}
        <del>{{ p.compare_at_price | money }}</del>
        {{ p.price | money }}
      {%- else -%}
        {{ p.price | money }}
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .wl-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .wl-card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .wl-card__link:focus-visible {
    outline: var(--style-border-width) solid var(--color-foreground);
    outline-offset: 3px;
  }

  .wl-card__media {
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    aspect-ratio: 2 / 3;
  }

  .wl-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .wl-card:hover .wl-card__img {
    transform: scale(1.03);
  }

  .wl-card__name {
    margin: var(--margin-sm) 0 0;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .wl-card__price {
    margin: 4px 0 0;
    font-size: 0.9375rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80));
  }

  .wl-card__price del {
    margin-inline-end: 6px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Scheda preferiti",
  "settings": [
    {
      "type": "paragraph",
      "content": "Sezione tecnica: la usa la pagina «I tuoi preferiti» per disegnare le schede salvate. Non va aggiunta a mano a una pagina."
    }
  ]
}
{% endschema %}
