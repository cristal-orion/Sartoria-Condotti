{%- liquid
  assign s = section.settings
  assign hero_title = s.hero_title | default: 'Condotti & Co'

  # Testo: usa l'impostazione se compilata, altrimenti la traduzione (locales/*.json → brand.condotti.*)
  assign eyebrow = 'brand.condotti.eyebrow' | t
  assign eyebrow = s.eyebrow | default: eyebrow
  assign hero_sub = 'brand.condotti.hero_sub' | t
  assign hero_sub = s.hero_sub | default: hero_sub
  assign intro_heading = 'brand.condotti.intro_heading' | t
  assign intro_heading = s.intro_heading | default: intro_heading
  assign intro_body = 'brand.condotti.intro_body' | t
  assign intro_body = s.intro_body | default: intro_body
  assign values_heading = 'brand.condotti.values_heading' | t
  assign values_heading = s.values_heading | default: values_heading
  assign collection_heading = 'brand.condotti.collection_heading' | t
  assign collection_heading = s.collection_heading | default: collection_heading
  assign cta_heading = 'brand.condotti.cta_heading' | t
  assign cta_heading = s.cta_heading | default: cta_heading
  assign cta_label = 'brand.condotti.cta_label' | t
  assign cta_label = s.cta_label | default: cta_label
  assign gallery_hint = 'brand.condotti.gallery_hint' | t
  assign gallery_hint = s.gallery_hint | default: gallery_hint
-%}

<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&display=swap">
{{ 'brand-page.css' | asset_url | stylesheet_tag }}

<section class="bp" data-bp-root>
  <!-- HERO (titolo + striscia foto) -->
  <header class="bp__hero-strip">
    <div class="bp__wrap bp__hero-strip__head">
      <p class="bp__eyebrow" data-reveal>{{ eyebrow }}</p>
      <h1 class="bp__display bp__hero-strip__title" data-reveal>{{ hero_title }}</h1>
      <p class="bp__hero-strip__sub" data-reveal>{{ hero_sub }}</p>
    </div>
    {%- if s.gallery_images != blank -%}
      {%- assign gallery_url_default = s.gallery_link | default: '/collections/condotti-co' -%}
      <div class="bp-gallery__track" data-reveal role="list">
        {%- assign gallery_files = s.gallery_images | split: ',' -%}
        {%- for raw in gallery_files -%}
          {%- assign parts = raw | split: '|' -%}
          {%- assign file = parts[0] | strip -%}
          {%- assign link = parts[1] | strip -%}
          {%- assign caption = parts[2] | strip -%}
          {%- if link == blank -%}{%- assign link = gallery_url_default -%}{%- endif -%}
          {%- assign a11y = caption | default: hero_title -%}
          {%- if file != blank -%}
            <figure class="bp-gallery__item" role="listitem"><a class="bp-gallery__link" href="{{ link }}" aria-label="{{ a11y | escape }} — vai alla collezione"><img src="{{ file | asset_url }}" width="1100" height="1650" loading="lazy" alt="{{ a11y | escape }}"><span class="bp-gallery__caption">{{ caption }}</span></a></figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if gallery_hint != blank -%}<p class="bp-gallery__hint" data-reveal>{{ gallery_hint }}</p>{%- endif -%}
    {%- endif -%}
  </header>

  <!-- INTRO -->
  <div class="bp__section bp__wrap">
    <div class="bp__intro">
      {%- if s.intro_eyebrow != blank -%}<p class="bp__eyebrow" data-reveal>{{ s.intro_eyebrow }}</p>{%- endif -%}
      <h2 class="bp__h2" data-reveal>{{ intro_heading }}</h2>
      <p class="bp__lead bp__body" data-reveal>{{ intro_body }}</p>
    </div>
  </div>

  <span class="bp__stitch bp__wrap" aria-hidden="true">
    <svg viewBox="0 0 1000 2" preserveAspectRatio="none"><line x1="0" y1="1" x2="1000" y2="1" stroke="currentColor" stroke-width="1.4" stroke-dasharray="7 5" vector-effect="non-scaling-stroke"/></svg>
  </span>

  <!-- VALORI -->
  <div class="bp__section bp__wrap">
    <div class="bp__section-head">
      {%- if s.values_eyebrow != blank -%}<p class="bp__eyebrow" data-reveal>{{ s.values_eyebrow }}</p>{%- endif -%}
      <h2 class="bp__h2" data-reveal>{{ values_heading }}</h2>
    </div>
    <div class="bp__steps">
      <div class="bp__step" data-reveal>
        <span class="bp__num">01</span>
        <h3>{{ 'brand.condotti.value1_title' | t }}</h3>
        <p class="bp__body">{{ 'brand.condotti.value1_body' | t }}</p>
      </div>
      <div class="bp__step" data-reveal>
        <span class="bp__num">02</span>
        <h3>{{ 'brand.condotti.value2_title' | t }}</h3>
        <p class="bp__body">{{ 'brand.condotti.value2_body' | t }}</p>
      </div>
      <div class="bp__step" data-reveal>
        <span class="bp__num">03</span>
        <h3>{{ 'brand.condotti.value3_title' | t }}</h3>
        <p class="bp__body">{{ 'brand.condotti.value3_body' | t }}</p>
      </div>
    </div>
  </div>

  <!-- SHOWCASE PRODOTTI (ink) -->
  <div class="bp bp--ink" style="background:rgb(var(--bp-ink));color:rgb(var(--bp-cream));">
    <div class="bp__section bp__wrap">
      <div class="bp__section-head">
        {%- if s.collection_eyebrow != blank -%}<p class="bp__eyebrow" data-reveal>{{ s.collection_eyebrow }}</p>{%- endif -%}
        <h2 class="bp__h2" data-reveal>{{ collection_heading }}</h2>
      </div>
      {%- if s.collection != blank and s.collection.products_count > 0 -%}
        <div class="bp__products" data-reveal>
          {%- for product in s.collection.products limit: s.products_limit -%}
            <a class="bp__product" href="{{ product.url }}">
              <div class="bp__product-media">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 800 | image_tag: widths: '300,500,800', sizes: '(max-width:640px) 50vw, 25vw', loading: 'lazy' }}
                {%- endif -%}
              </div>
              <p class="bp__product-title">{{ product.title }}</p>
              <p class="bp__product-price">{{ product.price | money }}</p>
            </a>
          {%- endfor -%}
        </div>
        <div data-reveal style="margin-top:clamp(36px,4vw,56px);">
          <a class="bp__btn" href="{{ s.collection.url }}">{{ 'brand.common.view_all_collection' | t }}</a>
        </div>
      {%- else -%}
        <p class="bp__body" data-reveal style="max-width:46ch;">{{ 'brand.condotti.collection_empty' | t }}</p>
      {%- endif -%}
    </div>
  </div>

  <!-- CTA -->
  <div class="bp__section bp__wrap">
    <div class="bp__cta">
      {%- if s.cta_eyebrow != blank -%}<p class="bp__eyebrow" data-reveal>{{ s.cta_eyebrow }}</p>{%- endif -%}
      <h2 class="bp__display" data-reveal>{{ cta_heading }}</h2>
      <a class="bp__btn" href="{{ s.cta_link | default: '/collections/condotti-co' }}" data-reveal>{{ cta_label }}</a>
    </div>
  </div>
</section>

<script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
<script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
<script src="{{ 'brand-page.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Brand · Condotti & Co",
  "tag": "section",
  "class": "brand-page-section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Immagine hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Vuoto = usa la traduzione (brand.condotti.eyebrow)." },
    { "type": "text", "id": "hero_title", "label": "Titolo", "default": "Condotti & Co" },
    { "type": "textarea", "id": "hero_sub", "label": "Sottotitolo", "info": "Vuoto = usa la traduzione." },
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "intro_eyebrow", "label": "Eyebrow intro" },
    { "type": "text", "id": "intro_heading", "label": "Titolo intro", "info": "Vuoto = usa la traduzione." },
    { "type": "textarea", "id": "intro_body", "label": "Testo intro", "info": "Vuoto = usa la traduzione." },
    { "type": "header", "content": "Hero · striscia foto" },
    { "type": "textarea", "id": "gallery_images", "label": "Foto hero (file in assets/, separati da virgola)", "info": "Formato per ogni foto: nomefile | /collections/handle | Nome collezione. Le ultime due parti sono opzionali. Verifica che gli handle delle collezioni siano corretti e abbina ogni foto alla collezione giusta. Lascia vuoto per nascondere la striscia.", "default": "condottico-abiti.webp | /collections/maglioni | Abiti, condottico-giacche.webp | /collections/cappotti | Giacche, condottico-camicie.webp | /collections/camicie | Camicie, condottico-polo.webp | /collections/polo-t-shirt | Polo & T-Shirt, condottico-scarpe.webp | /collections/scarpe | Scarpe, condottico-giubbotti.webp | /collections/giubbotti | Giubbotti" },
    { "type": "url", "id": "gallery_link", "label": "Link foto hero (collezione di riserva)", "info": "Dove portano le foto SENZA link specifico (formato sopra). Default: collezione Condotti & Co." },
    { "type": "text", "id": "gallery_hint", "label": "Nota striscia", "info": "Vuoto = usa la traduzione (‹ scorri ›)." },
    { "type": "header", "content": "Valori" },
    { "type": "text", "id": "values_eyebrow", "label": "Eyebrow valori" },
    { "type": "text", "id": "values_heading", "label": "Titolo valori", "info": "Vuoto = usa la traduzione." },
    { "type": "header", "content": "Showcase prodotti" },
    { "type": "text", "id": "collection_eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "collection_heading", "label": "Titolo", "info": "Vuoto = usa la traduzione." },
    { "type": "collection", "id": "collection", "label": "Collezione" },
    { "type": "range", "id": "products_limit", "label": "Prodotti mostrati", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "header", "content": "CTA finale" },
    { "type": "text", "id": "cta_eyebrow", "label": "Eyebrow CTA" },
    { "type": "text", "id": "cta_heading", "label": "Titolo CTA", "info": "Vuoto = usa la traduzione." },
    { "type": "text", "id": "cta_label", "label": "Etichetta bottone", "info": "Vuoto = usa la traduzione." },
    { "type": "url", "id": "cta_link", "label": "Link bottone" }
  ],
  "presets": [{ "name": "Brand · Condotti & Co" }]
}
{% endschema %}
