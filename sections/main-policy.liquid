{%- comment -%}
  Template delle pagine "Policy" di Shopify (privacy, rimborsi, termini, spedizioni…).
  Senza questa sezione Shopify usa un fallback grezzo: titolo display gigante e testo minuscolo.
  Qui il titolo ha una dimensione sobria e il corpo una tipografia leggibile long-form.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&display=swap">

<section class="policy-page color-{{ section.settings.color_scheme }}">
  <div class="policy-page__wrap">
    <h1 class="policy-page__title">{{ page.title }}</h1>
    <div class="policy-page__body rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% stylesheet %}
  .policy-page {
    padding-block: clamp(48px, 8vw, 104px);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .policy-page__wrap {
    width: min(760px, 100% - clamp(32px, 8vw, 80px));
    margin-inline: auto;
  }

  .policy-page__title {
    margin: 0 0 clamp(28px, 4vw, 48px);
    font-family: 'Fraunces', var(--font-heading--family, serif);
    font-weight: 300;
    font-variation-settings: 'opsz' 144;
    font-size: clamp(1.9rem, 3.5vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .policy-page__body {
    font-family: var(--font-body--family, system-ui);
    font-size: 1rem;
    line-height: 1.72;
    color: rgb(var(--color-foreground-rgb, 14 14 12) / 0.85);
  }

  .policy-page__body > :first-child {
    margin-top: 0;
  }

  .policy-page__body p {
    margin: 0 0 1.1em;
  }

  .policy-page__body h2 {
    font-family: 'Fraunces', var(--font-heading--family, serif);
    font-weight: 400;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 1.9em 0 0.6em;
    color: rgb(var(--color-foreground-rgb, 14 14 12));
  }

  .policy-page__body h3,
  .policy-page__body h4 {
    font-family: var(--font-body--family, system-ui);
    font-weight: 600;
    font-size: 1.05rem;
    margin: 1.5em 0 0.5em;
    color: rgb(var(--color-foreground-rgb, 14 14 12));
  }

  .policy-page__body ul,
  .policy-page__body ol {
    margin: 0 0 1.1em;
    padding-inline-start: 1.4em;
  }

  .policy-page__body li {
    margin-bottom: 0.4em;
  }

  .policy-page__body a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  .policy-page__body strong {
    font-weight: 600;
    color: rgb(var(--color-foreground-rgb, 14 14 12));
  }

  .policy-page__body table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.2em;
    font-size: 0.95rem;
  }

  .policy-page__body :is(th, td) {
    border: 1px solid rgb(var(--color-foreground-rgb, 14 14 12) / 0.18);
    padding: 0.5em 0.7em;
    text-align: left;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Policy",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
