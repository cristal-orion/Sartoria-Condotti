{%- liquid
  assign s = section.settings
  assign hero_title = s.hero_title | default: 'Sarto a Domicilio'

  # Testo: usa l'impostazione se compilata, altrimenti la traduzione (locales/*.json → brand.sarto_domicilio.*)
  assign eyebrow = 'brand.sarto_domicilio.eyebrow' | t
  assign eyebrow = s.eyebrow | default: eyebrow
  assign hero_sub = 'brand.sarto_domicilio.hero_sub' | t
  assign hero_sub = s.hero_sub | default: hero_sub
  assign intro_eyebrow = 'brand.sarto_domicilio.intro_eyebrow' | t
  assign intro_eyebrow = s.intro_eyebrow | default: intro_eyebrow
  assign intro_heading = 'brand.sarto_domicilio.intro_heading' | t
  assign intro_heading = s.intro_heading | default: intro_heading
  assign intro_body = 'brand.sarto_domicilio.intro_body' | t
  assign intro_body = s.intro_body | default: intro_body
  assign how_eyebrow = 'brand.sarto_domicilio.how_eyebrow' | t
  assign how_eyebrow = s.how_eyebrow | default: how_eyebrow
  assign how_heading = 'brand.sarto_domicilio.how_heading' | t
  assign how_heading = s.how_heading | default: how_heading
  assign form_eyebrow = 'brand.sarto_domicilio.form_eyebrow' | t
  assign form_eyebrow = s.form_eyebrow | default: form_eyebrow

  assign has_negozio = false
  if s.cal_link != blank and s.cal_link_negozio != blank
    assign has_negozio = true
  endif

  assign form_heading = s.form_heading
  if form_heading == blank
    if s.deposit_enabled and s.cal_link_negozio != blank
      assign form_heading = 'brand.sarto_domicilio.form_heading_appointment' | t
    elsif s.deposit_enabled
      assign form_heading = 'brand.sarto_domicilio.form_heading_domicilio_deposit' | t
    elsif has_negozio
      assign form_heading = 'brand.sarto_domicilio.form_heading_appointment' | t
    else
      assign form_heading = 'brand.sarto_domicilio.form_heading_domicilio' | t
    endif
  endif

  assign form_body = s.form_body
  if form_body == blank
    if s.deposit_enabled and s.cal_link_negozio != blank
      assign form_body = 'brand.sarto_domicilio.form_body_both_deposit' | t
    elsif s.deposit_enabled
      assign form_body = 'brand.sarto_domicilio.form_body_deposit' | t
    elsif has_negozio
      assign form_body = 'brand.sarto_domicilio.form_body_both' | t
    else
      assign form_body = 'brand.sarto_domicilio.form_body_simple' | t
    endif
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&display=swap">
{{ 'brand-page.css' | asset_url | stylesheet_tag }}

<section class="bp" data-bp-root>
  <!-- HERO -->
  <header class="bp__hero">
    <div class="bp__hero-media">
      {%- if s.hero_image != blank -%}
        {{ s.hero_image | image_url: width: 2400 | image_tag: widths: '900,1400,1900,2400', sizes: '100vw', fetchpriority: 'high' }}
      {%- else -%}
        <img src="{{ 'sartodomicilio34.webp' | asset_url }}" alt="" fetchpriority="high">
      {%- endif -%}
    </div>
    <div class="bp__hero-inner bp__wrap">
      <p class="bp__eyebrow" data-reveal>{{ eyebrow }}</p>
      <h1 class="bp__display bp__hero-title" data-reveal>{{ hero_title }}</h1>
      <p class="bp__hero-sub" data-reveal>{{ hero_sub }}</p>
    </div>
  </header>

  <!-- INTRO -->
  <div class="bp__section bp__wrap">
    <div class="bp__intro">
      <p class="bp__eyebrow" data-reveal>{{ intro_eyebrow }}</p>
      <h2 class="bp__h2" data-reveal>{{ intro_heading }}</h2>
      <p class="bp__lead bp__body" data-reveal>{{ intro_body }}</p>
    </div>
  </div>

  <span class="bp__stitch bp__wrap" aria-hidden="true">
    <svg viewBox="0 0 1000 2" preserveAspectRatio="none"><line x1="0" y1="1" x2="1000" y2="1" stroke="currentColor" stroke-width="1.4" stroke-dasharray="7 5" vector-effect="non-scaling-stroke"/></svg>
  </span>

  <!-- COME FUNZIONA -->
  <div class="bp__section bp__wrap">
    <div class="bp__section-head">
      <p class="bp__eyebrow" data-reveal>{{ how_eyebrow }}</p>
      <h2 class="bp__h2" data-reveal>{{ how_heading }}</h2>
    </div>
    <div class="bp__steps">
      <div class="bp__step" data-reveal>
        <span class="bp__num">01</span>
        <h3>{{ 'brand.sarto_domicilio.step1_title' | t }}</h3>
        <p class="bp__body">{{ 'brand.sarto_domicilio.step1_body' | t }}</p>
      </div>
      <div class="bp__step" data-reveal>
        <span class="bp__num">02</span>
        <h3>{{ 'brand.sarto_domicilio.step2_title' | t }}</h3>
        <p class="bp__body">{{ 'brand.sarto_domicilio.step2_body' | t }}</p>
      </div>
      <div class="bp__step" data-reveal>
        <span class="bp__num">03</span>
        <h3>{{ 'brand.sarto_domicilio.step3_title' | t }}</h3>
        <p class="bp__body">{{ 'brand.sarto_domicilio.step3_body' | t }}</p>
      </div>
    </div>
  </div>

  <!-- INVITO ALL'ATELIER DEL TESSUTO: prima di prenotare, guarda cosa si può fare -->
  {%- render 'bp-tessuti-teaser', section: section -%}

  <!-- FORM RICHIESTA (ink) -->
  <div class="bp bp--ink" style="background:rgb(var(--bp-ink));color:rgb(var(--bp-cream));">
    <div class="bp__section bp__wrap" id="prenota">
      <div class="bp__form-layout">
        <div class="bp__diptych-text">
          <p class="bp__eyebrow" data-reveal>{{ form_eyebrow }}</p>
          <h2 class="bp__h2" data-reveal>{{ form_heading }}</h2>
          <p class="bp__body" data-reveal>{{ form_body }}</p>
        </div>

        <div data-reveal>
          {%- liquid
            assign show_deposit = false
            if s.deposit_enabled and s.deposit_variant_id != blank
              assign show_deposit = true
            endif
            assign has_boutique = false
            if s.cal_link_negozio != blank
              assign has_boutique = true
            endif
            assign has_domicilio_cal = false
            if s.cal_link != blank and show_deposit == false
              assign has_domicilio_cal = true
            endif
            assign has_domicilio = false
            if show_deposit or has_domicilio_cal
              assign has_domicilio = true
            endif
            assign show_tabs = false
            if has_domicilio and has_boutique
              assign show_tabs = true
            endif
            assign needs_cal = false
            if has_domicilio_cal or has_boutique
              assign needs_cal = true
            endif
          -%}
          {%- if show_deposit or has_domicilio_cal or has_boutique -%}
            <style>
              .bp__cal-tabs { display: flex; gap: .5rem; margin-bottom: 1.4rem; flex-wrap: wrap; }
              .bp__cal-tab { appearance: none; -webkit-appearance: none; cursor: pointer; background: transparent; color: rgb(var(--bp-cream) / 0.7); border: 1px solid rgb(var(--bp-cream) / 0.25); border-radius: 999px; padding: .62em 1.5em; font-family: var(--font-body--family, system-ui); font-size: .74rem; letter-spacing: .12em; text-transform: uppercase; transition: background .25s ease, color .25s ease, border-color .25s ease; }
              .bp__cal-tab:hover { border-color: rgb(var(--bp-cream) / 0.55); color: rgb(var(--bp-cream)); }
              .bp__cal-tab.is-active { background: #C9A24B; border-color: #C9A24B; color: #0e0e0c; }
            </style>
            {%- if show_tabs -%}
              <div class="bp__cal-tabs" role="tablist" aria-label="{{ 'brand.sarto_domicilio.tabs_aria' | t | escape }}">
                <button type="button" class="bp__cal-tab is-active" data-cal-tab="domicilio" role="tab" aria-selected="true">{{ 'brand.sarto_domicilio.tab_domicilio' | t }}</button>
                <button type="button" class="bp__cal-tab" data-cal-tab="negozio" role="tab" aria-selected="false">{{ 'brand.sarto_domicilio.tab_negozio' | t }}</button>
              </div>
            {%- endif -%}

            {%- comment -%} Pannello A DOMICILIO: acconto (a pagamento) oppure calendario {%- endcomment -%}
            <div data-cal-panel="domicilio">
              {%- if show_deposit -%}
                <div class="bp__deposit">
                  <a class="bp__btn" href="/cart/{{ s.deposit_variant_id }}:1">{{ s.deposit_button_label | default: 'Paga l’acconto e prenota — 100 €' }}</a>
                  <p class="bp__form-note" style="margin-top:1.2rem;">{{ s.deposit_note | default: 'Acconto di 100 €, scalato sull’acquisto finale. Dopo il pagamento ricevi via email il link per scegliere giorno e ora dell’appuntamento.' }}</p>
                </div>
              {%- elsif has_domicilio_cal -%}
                <div id="sd-cal" class="bp__cal" aria-label="Calendario sarto a domicilio" style="min-height:560px;width:100%"></div>
                <p class="bp__form-note" style="margin-top:1.1rem;">{{ 'brand.sarto_domicilio.cal_note_domicilio' | t }}</p>
              {%- endif -%}
            </div>

            {%- comment -%} Pannello IN BOUTIQUE: sempre gratuito {%- endcomment -%}
            {%- if has_boutique -%}
              <div data-cal-panel="negozio"{% if show_tabs %} style="display:none"{% endif %}>
                <div id="sd-cal-negozio" class="bp__cal" aria-label="Calendario visita in boutique" style="min-height:560px;width:100%"></div>
                <p class="bp__form-note" style="margin-top:1.1rem;">{{ 'brand.sarto_domicilio.cal_note_negozio' | t }}</p>
              </div>
            {%- endif -%}

            {%- if needs_cal -%}
            <script type="text/javascript">
              (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.eu/embed/embed.js", "init");
              {%- if has_domicilio_cal -%}
              Cal("init", "sarto", {origin:"https://cal.eu"});
              Cal.ns.sarto("inline", { elementOrSelector: "#sd-cal", calLink: {{ s.cal_link | json }}, config: { "layout": "month_view", "theme": "dark" } });
              Cal.ns.sarto("ui", { "theme": "dark", "cssVarsPerTheme": { "dark": { "cal-brand": "#C9A24B" } }, "hideEventTypeDetails": false, "layout": "month_view" });
              {%- endif -%}
              {%- if has_boutique -%}
              var sdNegozioInit = false;
              function sdInitNegozio() {
                if (sdNegozioInit) return; sdNegozioInit = true;
                Cal("init", "negozio", { origin: "https://cal.eu" });
                Cal.ns.negozio("inline", { elementOrSelector: "#sd-cal-negozio", calLink: {{ s.cal_link_negozio | json }}, config: { "layout": "month_view", "theme": "dark" } });
                Cal.ns.negozio("ui", { "theme": "dark", "cssVarsPerTheme": { "dark": { "cal-brand": "#C9A24B" } }, "hideEventTypeDetails": false, "layout": "month_view" });
              }
              {%- unless show_tabs -%}
              sdInitNegozio();
              {%- endunless -%}
              {%- endif -%}
              {%- if show_tabs -%}
              (function () {
                var tabs = document.querySelectorAll('.bp__cal-tab');
                var panels = { domicilio: document.querySelector('[data-cal-panel="domicilio"]'), negozio: document.querySelector('[data-cal-panel="negozio"]') };
                tabs.forEach(function (tab) {
                  tab.addEventListener('click', function () {
                    var key = tab.getAttribute('data-cal-tab');
                    tabs.forEach(function (t) { var on = t === tab; t.classList.toggle('is-active', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); });
                    Object.keys(panels).forEach(function (k) { if (panels[k]) panels[k].style.display = (k === key ? 'block' : 'none'); });
                    if (key === 'negozio') sdInitNegozio();
                  });
                });
              })();
              {%- endif -%}
            </script>
            {%- endif -%}
          {%- else -%}
          {%- form 'contact', id: 'sarto-domicilio-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="bp__form-success">{{ 'brand.sarto_domicilio.form_success' | t }}</div>
            {%- endif -%}
            {%- if form.errors -%}
              <div class="bp__form-success" style="background:rgba(180,60,40,.18);border-color:#b43c28;">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <input type="hidden" name="contact[Tipo richiesta]" value="Sarto a domicilio">

            <div class="bp__form">
              <div class="bp__field">
                <label for="sd-name">{{ 'brand.sarto_domicilio.fld_name' | t }}</label>
                <input type="text" id="sd-name" name="contact[name]" required value="{{ form.name }}">
              </div>
              <div class="bp__field">
                <label for="sd-phone">{{ 'brand.sarto_domicilio.fld_phone' | t }}</label>
                <input type="tel" id="sd-phone" name="contact[phone]" placeholder="+39" value="{{ form.phone }}">
              </div>
              <div class="bp__field">
                <label for="sd-email">{{ 'brand.sarto_domicilio.fld_email' | t }}</label>
                <input type="email" id="sd-email" name="contact[email]" required value="{{ form.email }}">
              </div>
              <div class="bp__field">
                <label for="sd-zona">{{ 'brand.sarto_domicilio.fld_zona' | t }}</label>
                <input type="text" id="sd-zona" name="contact[Zona]" placeholder="{{ 'brand.sarto_domicilio.zona_placeholder' | t | escape }}">
              </div>
              <div class="bp__field">
                <label for="sd-servizio">{{ 'brand.sarto_domicilio.fld_servizio' | t }}</label>
                <select id="sd-servizio" name="contact[Servizio]">
                  <option value="Presa misure su misura">{{ 'brand.sarto_domicilio.servizio_1' | t }}</option>
                  <option value="Prova capo">{{ 'brand.sarto_domicilio.servizio_2' | t }}</option>
                  <option value="Riparazione / modifica">{{ 'brand.sarto_domicilio.servizio_3' | t }}</option>
                  <option value="Consulenza di stile">{{ 'brand.sarto_domicilio.servizio_4' | t }}</option>
                </select>
              </div>
              <div class="bp__field">
                <label for="sd-data">{{ 'brand.sarto_domicilio.fld_data' | t }}</label>
                <input type="date" id="sd-data" name="contact[Data preferita]">
              </div>
              <div class="bp__field">
                <label for="sd-fascia">{{ 'brand.sarto_domicilio.fld_fascia' | t }}</label>
                <select id="sd-fascia" name="contact[Fascia oraria]">
                  <option value="Mattina (9–13)">{{ 'brand.sarto_domicilio.fascia_1' | t }}</option>
                  <option value="Pomeriggio (14–18)">{{ 'brand.sarto_domicilio.fascia_2' | t }}</option>
                  <option value="Sera (18–20)">{{ 'brand.sarto_domicilio.fascia_3' | t }}</option>
                </select>
              </div>
              <div class="bp__field bp__field--full">
                <label for="sd-note">{{ 'brand.sarto_domicilio.fld_note' | t }}</label>
                <textarea id="sd-note" name="contact[body]" placeholder="{{ 'brand.sarto_domicilio.note_placeholder' | t | escape }}"></textarea>
              </div>
              <div class="bp__form-actions">
                <button type="submit" class="bp__btn">{{ 'brand.sarto_domicilio.submit' | t }}</button>
                <p class="bp__form-note">{{ 'brand.sarto_domicilio.form_note' | t }}</p>
              </div>
            </div>
          {%- endform -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
<script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
<script src="{{ 'brand-page.js' | asset_url }}" defer></script>
<script src="{{ 'bp-atelier.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Brand · Sarto a Domicilio",
  "tag": "section",
  "class": "brand-page-section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Immagine hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Vuoto = usa la traduzione (brand.sarto_domicilio.eyebrow)." },
    { "type": "text", "id": "hero_title", "label": "Titolo", "default": "Sarto a Domicilio" },
    { "type": "textarea", "id": "hero_sub", "label": "Sottotitolo", "info": "Vuoto = usa la traduzione." },
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "intro_eyebrow", "label": "Eyebrow intro", "info": "Vuoto = usa la traduzione." },
    { "type": "text", "id": "intro_heading", "label": "Titolo intro", "info": "Vuoto = usa la traduzione." },
    { "type": "textarea", "id": "intro_body", "label": "Testo intro", "info": "Vuoto = usa la traduzione." },
    { "type": "header", "content": "Come funziona" },
    { "type": "text", "id": "how_eyebrow", "label": "Eyebrow", "info": "Vuoto = usa la traduzione." },
    { "type": "text", "id": "how_heading", "label": "Titolo", "info": "Vuoto = usa la traduzione." },
    { "type": "header", "content": "Invito all'Atelier del Tessuto", "info": "Blocco tra “Come funziona” e la prenotazione: mostra un'anteprima animata dei tessuti e porta alla pagina Atelier del Tessuto." },
    { "type": "checkbox", "id": "teaser_enabled", "label": "Mostra l'invito ai tessuti", "default": true },
    { "type": "text", "id": "teaser_eyebrow", "label": "Eyebrow", "info": "Vuoto = usa la traduzione." },
    { "type": "text", "id": "teaser_heading", "label": "Titolo", "info": "Vuoto = usa la traduzione." },
    { "type": "textarea", "id": "teaser_body", "label": "Testo", "info": "Vuoto = usa la traduzione." },
    { "type": "text", "id": "teaser_cta_label", "label": "Etichetta bottone", "info": "Vuoto = usa la traduzione." },
    { "type": "url", "id": "teaser_link", "label": "Link", "info": "Vuoto = /pages/atelier-del-tessuto" },
    { "type": "textarea", "id": "teaser_images", "label": "Foto dell'anteprima (file in assets/)", "info": "Una coppia per tessuto, separate da virgola. Formato: campione | capo | nome. Servono almeno due coppie perché l'anteprima si animi.", "default": "tessuto-abito-inverno-1-a.jpg | tessuto-abito-inverno-1-b.jpg | Grigio gessato, tessuto-abito-1-a.jpg | tessuto-abito-1-b.jpg | Beige sabbia, tessuto-giacca-inverno-4-a.jpg | tessuto-giacca-inverno-4-b.jpg | Tortora cashmere, tessuto-abito-3-a.jpg | tessuto-abito-3-b.jpg | Azzurro lino" },
    { "type": "video", "id": "teaser_video", "label": "Video (opzionale)", "info": "Se carichi un video sostituisce l'anteprima animata. Parte da solo, muto e in loop." },
    { "type": "header", "content": "Acconto (prenotazione a pagamento)" },
    { "type": "checkbox", "id": "deposit_enabled", "label": "Richiedi acconto per prenotare", "info": "Se attivo, al posto del calendario/form compare il bottone per pagare l’acconto. Il link cal.com per scegliere data/ora va inserito nell’email di conferma ordine.", "default": false },
    { "type": "text", "id": "deposit_variant_id", "label": "ID variante prodotto acconto", "info": "ID numerico della variante del prodotto ‘Sarto a domicilio’ (100 €).", "default": "53840584933714" },
    { "type": "text", "id": "deposit_button_label", "label": "Etichetta bottone", "default": "Paga l’acconto e prenota — 100 €" },
    { "type": "textarea", "id": "deposit_note", "label": "Nota sotto il bottone" },
    { "type": "header", "content": "Prenotazione (cal.com)" },
    { "type": "text", "id": "cal_link", "label": "Link cal.com — Sarto a domicilio", "info": "Incolla username/evento di cal.eu, es. sartoriacondotti/sarto-a-domicilio. Se vuoto, resta il vecchio form via email." },
    { "type": "text", "id": "cal_link_negozio", "label": "Link cal.com — Visita in boutique", "info": "Secondo evento cal.eu, es. sartoriacondotti/visita-in-boutique. Se compilato, sulla pagina compaiono i due tab 'A domicilio / In boutique'." },
    { "type": "header", "content": "Form richiesta" },
    { "type": "text", "id": "form_eyebrow", "label": "Eyebrow form", "info": "Vuoto = usa la traduzione." },
    { "type": "text", "id": "form_heading", "label": "Titolo form", "info": "Vuoto = usa la traduzione." },
    { "type": "textarea", "id": "form_body", "label": "Testo form", "info": "Vuoto = usa la traduzione." }
  ],
  "presets": [{ "name": "Brand · Sarto a Domicilio" }]
}
{% endschema %}
